#!/usr/bin/env bash
# faigrid-release — release preparation helper
# Usage: ./scripts/faigrid-release [NEW_VERSION]
# Example: ./scripts/faigrid-release 1.7.0
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION_FILE="${REPO_ROOT}/VERSION"
INSTALL_SH="${REPO_ROOT}/install.sh"
CHANGELOG="${REPO_ROOT}/CHANGELOG.md"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'

ok()   { echo -e "  ${GREEN}✔${NC}  $1"; }
warn() { echo -e "  ${YELLOW}⚠${NC}  $1"; }
fail() { echo -e "  ${RED}✘${NC}  $1" >&2; exit 1; }
info() { echo -e "  ${CYAN}ℹ${NC}  $1"; }

echo ""
echo -e "  ${BOLD}faigrid-release${NC}"
echo ""

# ── Determine version ─────────────────────────────────────────────────────────
CURRENT_VER="$(cat "$VERSION_FILE" | tr -d '[:space:]')"
NEW_VER="${1:-}"

if [[ -z "$NEW_VER" ]]; then
    info "Current version: ${CURRENT_VER}"
    printf "  New version: "; read -r NEW_VER
fi

if [[ -z "$NEW_VER" ]]; then
    fail "No version provided."
fi

# Validate semver format
if ! echo "$NEW_VER" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$'; then
    fail "Version must be MAJOR.MINOR.PATCH (got: ${NEW_VER})"
fi

echo ""
info "Preparing release: ${CURRENT_VER} → ${NEW_VER}"
echo ""

# ── Pre-flight checks ─────────────────────────────────────────────────────────
info "── Pre-flight checks"

# Clean working tree
if ! git -C "$REPO_ROOT" diff --quiet 2>/dev/null; then
    warn "Working tree has uncommitted changes — commit or stash first."
fi

# On main branch
BRANCH="$(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
if [[ "$BRANCH" != "main" ]]; then
    warn "Not on main branch (current: ${BRANCH})"
fi

# ── Update version files ──────────────────────────────────────────────────────
echo ""
info "── Updating version files"

echo "${NEW_VER}" > "$VERSION_FILE"
ok "VERSION → ${NEW_VER}"

# install.sh: update comment + ASCII art display
sed -i.bak "s/# Version ${CURRENT_VER}/# Version ${NEW_VER}/" "$INSTALL_SH"
sed -i.bak "s/v${CURRENT_VER}/v${NEW_VER}/g" "$INSTALL_SH"
rm -f "${INSTALL_SH}.bak"
ok "install.sh → v${NEW_VER}"

# ── Update CHANGELOG ──────────────────────────────────────────────────────────
echo ""
info "── Updating CHANGELOG.md"

if command -v git-cliff &>/dev/null; then
    git-cliff --config "$REPO_ROOT/.cliff.toml" \
              --tag "v${NEW_VER}" \
              --output "$CHANGELOG" 2>/dev/null \
        && ok "CHANGELOG.md generated via git-cliff" \
        || warn "git-cliff failed — update CHANGELOG.md manually"
else
    warn "git-cliff not installed — update CHANGELOG.md manually"
    info "  Install: cargo install git-cliff"
fi

# ── Summary & next steps ──────────────────────────────────────────────────────
echo ""
info "── Next steps"
echo ""
echo -e "  ${BOLD}1. Review changes:${NC}"
echo "     git diff"
echo ""
echo -e "  ${BOLD}2. Commit:${NC}"
echo "     git add VERSION install.sh CHANGELOG.md"
echo "     git commit -m \"chore: release v${NEW_VER}\""
echo ""
echo -e "  ${BOLD}3. Tag & push:${NC}"
echo "     git tag v${NEW_VER}"
echo "     git push origin main --tags"
echo ""
echo -e "  ${BOLD}4. GitHub release:${NC}"
echo "     gh release create v${NEW_VER} --generate-notes --title \"v${NEW_VER}\""
echo ""
info "  Release-please will auto-create the GitHub release if configured."
echo ""
